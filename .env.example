# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES
# ==============================================================================

# Server configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Database connection (Neon or standard Postgres)
# Use NEON_DATABASE_URL for Neon.tech or DATABASE_URL for other Postgres providers
NEON_DATABASE_URL=postgres://user:password@hostname/dbname?sslmode=require
DATABASE_URL=postgres://user:password@hostname/dbname

# Security & Authentication
SESSION_SECRET=change-me-to-a-long-random-string-in-production
ORGANIZER_PASSWORD=default-password-for-seeding

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================

# The URL where the API server is hosted
# For local dev: http://localhost:3000
# For Vercel: https://your-api-server.vercel.app
VITE_API_URL=http://localhost:3000
